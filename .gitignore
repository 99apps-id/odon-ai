# Rust / Cargo
/target
**/*.rs.bk
# The workspace Cargo.lock is deliberately tracked: this is a binary
# application, so a pinned lockfile keeps builds reproducible and lets
# `cargo audit` in CI scan the exact dependency set that ships.
#
# The Tauri shell's lockfile is the exception and stays untracked: it is a
# separate workspace pinned to the local toolchain that produces the desktop
# bundle, and a committed copy only generates conflicts without making the
# shipped daemon any more reproducible.
/desktop/src-tauri/Cargo.lock

# Node / Desktop
node_modules
/desktop/node_modules
/desktop/dist
.DS_Store
*.local

# SQLite local data
*.db
*.db-journal
*.db-wal
*.db-shm

# Env and keys
.env
.env.*
!.env.example
.termixgo/
.termigo/
.odon/
*.pem
*.key
*.id_rsa
*.id_ed25519
ssh-profiles.json
approval-policies.json
mcp-servers.json

# Local build/test artifacts and agent tooling
*.log
.commandcode/
scripts/whatsapp-bridge/node_modules/
scripts/whatsapp-bridge/auth/

# Tauri sidecar staging (built binaries are copied here by the release
# workflow and by scripts/stage-sidecar.sh; only the placeholder is kept)
/desktop/src-tauri/binaries/*
!/desktop/src-tauri/binaries/.gitkeep
/desktop/src-tauri/target/
/desktop/src-tauri/gen/

# Agent scratch output (tool transcripts, chunk dumps)
rt_*.txt
runtime_chunk_*.txt
temp_runtime*.txt
