# ODON Environment Configuration

# Provider Credentials (BYOK)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Local / Self-Hosted Models
OLLAMA_BASE_URL=http://localhost:11434/v1

# OAuth Provider Configuration
# Loopback callback ports are fixed per provider in odon-provider and are not
# configurable; Antigravity credentials are stamped into the binary at build
# time (see crates/odon-provider/build.rs) or read from the environment.
ODON_ANTIGRAVITY_CLIENT_ID=
ODON_ANTIGRAVITY_CLIENT_SECRET=

# Note: Copy this file to .env.local and fill in real values.
# .env.local is gitignored and will NOT be committed.

# Daemon API security
# Required when binding to a non-loopback address (e.g. 0.0.0.0:4096).
# The desktop app sends it as Authorization: Bearer <token>.
ODON_API_TOKEN=
# Extra CORS origins (comma separated). localhost/127.0.0.1 are always allowed.
ODON_ALLOWED_ORIGINS=

# External Channels & Relays
# Telegram: create a bot with @BotFather, then paste the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of numeric user IDs or @usernames.
# Empty = deny everyone unless TELEGRAM_ALLOW_ANYONE=1.
TELEGRAM_ALLOWED_USERS=
# Explicit opt-in to accept Telegram messages without an allowlist (not recommended).
TELEGRAM_ALLOW_ANYONE=0

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Must match the "Verify token" you enter in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# Optional: validates X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Comma-separated allowlist of phone numbers (digits only, e.g. 62812...).
# Empty = deny everyone unless WHATSAPP_ALLOW_ANYONE=1.
WHATSAPP_ALLOWED_NUMBERS=
# Explicit opt-in to accept WhatsApp messages without an allowlist (not recommended).
WHATSAPP_ALLOW_ANYONE=0
# Optional Graph API version override.
WHATSAPP_API_VERSION=v21.0

# WhatsApp Web bridge (configured from Settings → Relays).
# Install deps once: cd scripts/whatsapp-bridge && npm install
WA_BRIDGE_PORT=4097
# Optional explicit bridge script path.
ODON_WHATSAPP_BRIDGE_SCRIPT=
# Allow group messages (0/1).
WA_ALLOW_GROUPS=0

# Model used for relay turns (Telegram/WhatsApp). Empty = daemon default.
ODON_RELAY_MODEL=

# Agent runtime tuning.
# Default model requested when a caller does not name one.
ODON_MODEL=
# Maximum agent/tool turns before a single request stops (default: 100).
ODON_MAX_TURN_ITERATIONS=
# Wall-clock budget for one turn, in seconds.
ODON_TURN_TIMEOUT_SECS=
# Per-tool execution timeout, in seconds.
ODON_TOOL_TIMEOUT_SECS=
# How long an approval card stays pending before it expires, in seconds.
ODON_APPROVAL_TIMEOUT_SECS=

# Desktop client -> daemon connection. Defaults to http://127.0.0.1:4096.
ODON_DAEMON_URL=

# Web tool SSRF policy (default: public http/https only).
# Set to 1 only if the agent must reach localhost/LAN services.
ODON_ALLOW_PRIVATE_NETWORK=0
# Optional allowlist/denylist for outbound web tools (comma separated, *.suffix supported).
ODON_ALLOWED_HOSTS=
ODON_BLOCKED_HOSTS=

# SSH keys may only be read from ~/.ssh, ~/.odon/ssh-keys, or these extra dirs.
ODON_SSH_KEY_DIRS=

# GitHub Connector
GITHUB_TOKEN=
