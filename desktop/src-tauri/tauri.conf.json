{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ODON",
  "version": "0.1.1",
  "identifier": "id.99apps.odon",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ODON",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app", "nsis"],
    "externalBin": ["binaries/odond"],
    "resources": {
      "../../scripts/whatsapp-bridge": "scripts/whatsapp-bridge"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "ODON - autonomous AI assistant",
    "longDescription": "ODON (Open Digital Orchestration Network) is a universal AI assistant and autonomous orchestration runtime with a local daemon, tool approval gates, and Telegram/WhatsApp relays.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
