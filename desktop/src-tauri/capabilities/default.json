{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The shell may start exactly one program: the bundled odond sidecar, with the arguments the shell itself builds.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/odond",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
